# Copie para ".env" (ignorado pelo Git) e ajuste. Carregue com:  set -a; source .env; set +a
DB_URL=jdbc:postgresql://localhost:5432/longevida
DB_USERNAME=longevida
DB_PASSWORD=troque-esta-senha

# Gere com:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=10080

APP_TIMEZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Use "dev" apenas em desenvolvimento local.
SPRING_PROFILES_ACTIVE=dev

# E-mail (opcional). Com MAIL_ENABLED=false nenhum e-mail é enviado.
MAIL_ENABLED=false
MAIL_FROM=no-reply@seu-dominio.com
# SPRING_MAIL_HOST=smtp.exemplo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
